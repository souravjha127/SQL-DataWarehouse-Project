/*
===============================================================================
Create Database and Schemas
===============================================================================
Script Purpose:
    This script creates a new database named 'DataWarehouse' and initializes
    three schemas: 'bronze', 'silver', and 'gold' to support a modern
    Medallion Architecture.

    The database is configured using UTF-8 encoding with the PostgreSQL
    'postgres' user as the owner.

    Schema Overview:
        - Bronze: Stores raw data extracted from source systems.
        - Silver: Stores cleaned, standardized, and transformed data.
        - Gold: Stores business-ready data for analytics and reporting.

WARNING:
    Running this script may result in the loss of existing data if the
    'DataWarehouse' database is dropped and recreated.

    All data stored in the database will be permanently deleted.
    Ensure that proper backups are available before executing this script.

===============================================================================
*/

-- ============================================================================
-- CREATE DATABASE
-- ============================================================================

-- DROP DATABASE IF EXISTS "DataWarehouse";

CREATE DATABASE "DataWarehouse"
    WITH
    OWNER = postgres
    ENCODING = 'UTF8'
    LC_COLLATE = 'English_India.1252'
    LC_CTYPE = 'English_India.1252'
    LOCALE_PROVIDER = 'libc'
    TABLESPACE = pg_default
    CONNECTION LIMIT = -1
    IS_TEMPLATE = False;


-- ============================================================================
-- CREATE SCHEMAS
-- ============================================================================

-- Bronze Layer: Stores raw source data
CREATE SCHEMA bronze;

-- Silver Layer: Stores cleaned and transformed data
CREATE SCHEMA silver;

-- Gold Layer: Stores business-ready analytical data
CREATE SCHEMA gold;
